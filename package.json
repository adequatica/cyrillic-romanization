{
  "name": "cyrillic-romanization",
  "version": "1.2.2",
  "description": "Convert Cyrillic characters to Latin characters (transliteration)",
  "keywords": [
    "ala-lc",
    "alphabet",
    "azerbaijani",
    "belarusian",
    "bulgarian",
    "cyrillic",
    "gaj",
    "iso9",
    "kazakh",
    "language",
    "latin",
    "macedonian",
    "mongolian",
    "montenegrin",
    "romanization",
    "russian",
    "serbian",
    "transliteration",
    "turkmen",
    "ukrainian",
    "uzbek"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/adequatica/cyrillic-romanization"
  },
  "author": "Andrey Enin",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "format": "npx prettier --write .",
    "lint": "eslint '**/*.{js,ts}'",
    "lint:fix": "eslint --fix",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
